---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Backdrop from '../components/Backdrop.astro';
import badge from '../assets/brand/tailhood-badge.png';
import { site } from '../config/site';

const badgeImg = await getImage({ src: badge, width: 192, format: 'webp' });
const year = new Date().getFullYear();
---

<BaseLayout
  title={`Puppy Enquiries | ${site.name}`}
  description="Interested in a Tailhood Golden Retriever puppy? Send us an enquiry and we will get back to you soon."
>
  <Fragment slot="head">
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </Fragment>

  <Backdrop paws={false} />

  <div class="page">
    <main class="wrap">
      <header class="intro">
        <a href="/" class="badge-link reveal" style="--d: 0.1s" aria-label="Tailhood Kennel home">
          <img src={badgeImg.src} width="96" height="96" alt="" class="badge" />
        </a>
        <p class="eyebrow reveal" style="--d: 0.2s">Tailhood Kennel</p>
        <h1 class="reveal" style="--d: 0.3s"><span class="gold-text">Puppy Enquiries</span></h1>
        <p class="lead reveal" style="--d: 0.4s">
          Interested in one of our {site.breed} puppies? Tell us a little about yourself and we'll be in touch.
        </p>
      </header>

      <form
        id="enquiry-form"
        class="card reveal"
        style="--d: 0.5s"
        method="post"
        action="/api/enquiry"
        novalidate
      >
        <div class="grid">
          <label class="field">
            <span>Name <em aria-hidden="true">*</em></span>
            <input name="name" type="text" autocomplete="name" required maxlength="100" />
          </label>

          <label class="field">
            <span>Email <em aria-hidden="true">*</em></span>
            <input name="email" type="email" autocomplete="email" required maxlength="200" />
          </label>

          <label class="field">
            <span>Phone / WhatsApp</span>
            <input name="phone" type="tel" autocomplete="tel" maxlength="40" inputmode="tel" />
          </label>

          <label class="field">
            <span>City</span>
            <input name="city" type="text" autocomplete="address-level2" maxlength="100" />
          </label>

          <label class="field full">
            <span>Interested in</span>
            <select name="interest">
              {site.enquiryInterests.map((o, i) => <option selected={i === 0}>{o}</option>)}
            </select>
          </label>

          <label class="field full">
            <span>Message <em aria-hidden="true">*</em></span>
            <textarea name="message" rows="3" required maxlength="3000"></textarea>
          </label>
        </div>

        <!-- Honeypot: hidden from people, bots tend to fill it -->
        <div class="hp" aria-hidden="true">
          <label>Company <input name="company" type="text" tabindex="-1" autocomplete="off" /></label>
        </div>

        <!-- Invisible unless Cloudflare decides a visitor needs to click the checkbox -->
        <div
          class="cf-turnstile"
          data-sitekey={site.turnstileSiteKey}
          data-theme="dark"
          data-appearance="interaction-only"
        >
        </div>

        <button type="submit" class="submit">
          <span class="label">Send enquiry</span>
        </button>

        <p class="status" role="status" aria-live="polite"></p>
      </form>
    </main>

    <footer class="footer reveal" style="--d: 0.6s">
      <p>
        <a href="/">&larr; Home</a>
        <span class="sep" aria-hidden="true">·</span>
        <a class="mail" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        <span class="sep" aria-hidden="true">·</span>
        <span class="copy">&copy; {year} {site.name}</span>
      </p>
    </footer>
  </div>
</BaseLayout>

<script>
  type TurnstileApi = { reset: (el?: Element | string) => void };

  const form = document.querySelector<HTMLFormElement>('#enquiry-form');
  const status = form?.querySelector<HTMLParagraphElement>('.status');
  const button = form?.querySelector<HTMLButtonElement>('.submit');

  const show = (msg: string, kind: 'ok' | 'error' | 'busy') => {
    if (!status) return;
    status.textContent = msg;
    status.dataset.kind = kind;
  };

  // No-JS fallback: the server redirects back with ?sent=1 or ?error=1
  const params = new URLSearchParams(location.search);
  if (params.has('sent')) show('Thank you! Your enquiry has been sent. We will get back to you soon.', 'ok');
  if (params.has('error')) show('Sorry, something went wrong. Please try again or email us.', 'error');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    if (!data.get('cf-turnstile-response')) {
      show('Please wait for the security check to finish, then try again.', 'error');
      return;
    }

    button?.setAttribute('disabled', '');
    show('Sending…', 'busy');

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      const json = (await res.json().catch(() => null)) as { ok?: boolean; message?: string } | null;

      if (res.ok && json?.ok) {
        form.reset();
        show(json.message ?? 'Thank you! Your enquiry has been sent.', 'ok');
      } else {
        show(json?.message ?? 'Sorry, something went wrong. Please try again.', 'error');
      }
    } catch {
      show('Network error. Please check your connection and try again.', 'error');
    } finally {
      button?.removeAttribute('disabled');
      (window as unknown as { turnstile?: TurnstileApi }).turnstile?.reset();
    }
  });
</script>

<style>
  /* Everything is sized with svh so the whole page fits one screen (no scrolling). */
  .page {
    position: relative;
    z-index: 2;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }

  .wrap {
    flex: 1;
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(12px, 2.4svh, 24px);
    padding: clamp(16px, 3svh, 36px) calc(var(--gutter) + 4px) 10px;
  }

  /* ---------- intro ---------- */
  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .badge {
    width: clamp(48px, 8svh, 76px);
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    box-shadow:
      0 0 0 1px rgba(212, 161, 42, 0.6),
      0 0 40px rgba(212, 161, 42, 0.28);
  }

  .eyebrow {
    margin: clamp(8px, 1.4svh, 14px) 0 4px;
    color: var(--gold-200);
    font-weight: 500;
    font-size: 0.72rem;
    letter-spacing: 0.45em;
    padding-left: 0.45em; /* balance trailing letter-spacing when centred */
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.6rem, min(6.5vw, 5svh), 2.4rem);
    line-height: 1.15;
  }

  .lead {
    max-width: 28rem;
    margin: 8px 0 0;
    color: var(--cream-dim);
    font-size: 0.95rem;
    text-wrap: balance;
  }

  /* short phone screens: drop the intro sentence to keep the form on screen */
  @media (max-width: 899px) and (max-height: 720px) {
    .lead {
      display: none;
    }
  }

  /* very short screens (e.g. 360×640): tighten a little more */
  @media (max-height: 660px) {
    .wrap {
      gap: 10px;
      padding-top: 12px;
    }

    .badge {
      width: 44px;
    }

    .card textarea {
      min-height: 56px;
      height: 56px;
    }
  }

  /* ---------- form card ---------- */
  .card {
    width: 100%;
    padding: clamp(16px, 3vw, 28px);
    border: 1px solid rgba(212, 161, 42, 0.35);
    border-radius: 16px;
    background: linear-gradient(160deg, rgba(28, 24, 16, 0.85), rgba(14, 14, 14, 0.9));
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
    text-align: left;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(10px, 1.6svh, 14px) 12px;
  }

  .full {
    grid-column: 1 / -1;
  }

  @media (max-width: 340px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .field span {
    overflow: hidden;
    color: var(--cream-dim);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .field em {
    color: var(--gold-200);
    font-style: normal;
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid rgba(243, 230, 196, 0.16);
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.35);
    color: var(--cream);
    font: inherit;
    font-size: 1rem; /* ≥16px prevents iOS zoom on focus */
    font-weight: 400;
    line-height: 1.4;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  textarea {
    display: block;
    height: clamp(68px, 13svh, 140px);
    min-height: 68px;
    resize: vertical;
  }

  select {
    appearance: none;
    background-image:
      linear-gradient(45deg, transparent 50%, var(--gold-400) 50%),
      linear-gradient(135deg, var(--gold-400) 50%, transparent 50%);
    background-position:
      calc(100% - 20px) 55%,
      calc(100% - 14px) 55%;
    background-size: 6px 6px;
    background-repeat: no-repeat;
    padding-right: 40px;
  }

  select option {
    background: #1a1a1a;
    color: var(--cream);
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--gold-400);
    box-shadow: 0 0 0 3px rgba(212, 161, 42, 0.22);
  }

  input:user-invalid,
  textarea:user-invalid {
    border-color: #d9735b;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .cf-turnstile {
    display: flex;
    justify-content: center;
  }

  .cf-turnstile:has(iframe) {
    margin-top: 12px;
  }

  .submit {
    width: 100%;
    margin-top: clamp(12px, 2svh, 18px);
    padding: 13px 20px;
    border: 0;
    border-radius: 999px;
    background: var(--gold-gradient);
    background-size: 200% 100%;
    background-position: 100% 0;
    color: #1a1204;
    font: inherit;
    font-weight: 500;
    font-size: 0.88rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-position 0.5s var(--ease-out),
      transform 0.2s var(--ease-out),
      box-shadow 0.3s;
  }

  .submit:hover {
    background-position: 0% 0;
    transform: translateY(-1px);
    box-shadow: 0 10px 30px rgba(212, 161, 42, 0.3);
  }

  .submit:focus-visible {
    outline: 2px solid var(--gold-100);
    outline-offset: 3px;
  }

  .submit[disabled] {
    opacity: 0.6;
    cursor: wait;
    transform: none;
  }

  .status {
    margin: 10px 0 0;
    font-size: 0.9rem;
    text-align: center;
  }

  .status:empty {
    display: none;
  }

  .status[data-kind='ok'] {
    color: #9fd89a;
  }

  .status[data-kind='error'] {
    color: #f0a08c;
  }

  .status[data-kind='busy'] {
    color: var(--cream-dim);
  }

  /* ---------- wide screens: intro left, form right ---------- */
  @media (min-width: 900px) {
    .wrap {
      max-width: 1040px;
      flex-direction: row;
      gap: clamp(40px, 6vw, 88px);
      padding-inline: calc(var(--gutter) + 24px);
    }

    .intro {
      flex: 1 1 0;
      align-items: flex-start;
      text-align: left;
    }

    .badge {
      width: clamp(64px, 11svh, 104px);
    }

    .eyebrow {
      margin-top: clamp(12px, 2.4svh, 22px);
      padding-left: 0;
    }

    h1 {
      font-size: clamp(2.2rem, min(3.8vw, 7svh), 3.3rem);
    }

    .lead {
      margin-top: 14px;
      font-size: 1.02rem;
      text-wrap: pretty;
    }

    .card {
      flex: 1.35 1 0;
      width: auto;
    }
  }

  /* ---------- footer ---------- */
  .footer {
    padding: 4px var(--gutter) clamp(14px, 2.6svh, 28px);
    text-align: center;
  }

  .footer p {
    margin: 0;
    color: var(--cream-faint);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .footer a {
    color: var(--cream-dim);
  }

  .footer .mail {
    color: var(--gold-200);
    letter-spacing: 0.06em;
    text-transform: none;
  }

  .footer a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer .sep {
    margin: 0 0.6em;
  }

  /* phones: email on its own line, then "← Home · © year" */
  @media (max-width: 520px) {
    .footer p {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
    }

    .footer .mail {
      order: -1;
      flex-basis: 100%;
      margin-bottom: 4px;
    }

    .footer .mail + .sep {
      display: none;
    }
  }
</style>
