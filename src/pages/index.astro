---
import BaseLayout from '../layouts/BaseLayout.astro';
import Backdrop from '../components/Backdrop.astro';
import Logo from '../components/Logo.astro';
import ContactSlot from '../components/ContactSlot.astro';
import { site } from '../config/site';

const year = new Date().getFullYear();
---

<BaseLayout>
  <Backdrop />

  <div class="page">
    <main class="stage">
      <Logo />

      <p class="eyebrow reveal" style="--d: 0.9s">Coming Soon</p>

      <h1 class="headline reveal" style="--d: 1.1s">
        <span class="gold-text">Something golden</span>
        <span class="gold-text">is on its way</span>
      </h1>

      <p class="sub reveal" style="--d: 1.35s">
        Healthy, well-raised {site.breed} puppies, coming soon to{' '}
        <span class="domain">tailhoodkennel.com</span>
      </p>

      <div class="divider reveal" style="--d: 1.6s" aria-hidden="true">
        <span class="rule"></span>
        <svg viewBox="0 0 64 64" class="paw"><use href="#paw"></use></svg>
        <span class="rule"></span>
      </div>

      <p class="status reveal" style="--d: 1.8s">
        <span class="pulse" aria-hidden="true"></span>
        Website launching soon
      </p>

      <a class="cta reveal" style="--d: 2s" href="/contact/">Enquire about puppies</a>
    </main>

    <footer class="footer reveal" style="--d: 2.2s">
      <ContactSlot />
      <p>
        {site.contact.email && (
          <>
            <a class="mail" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
            <span class="sep" aria-hidden="true">·</span>
          </>
        )}
        &copy; {year} {site.name}
      </p>
    </footer>
  </div>
</BaseLayout>

<style>
  .page {
    position: relative;
    z-index: 2;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }

  .stage {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(8px, 1.6svh, 16px);
    padding: calc(var(--gutter) + 28px) calc(var(--gutter) + 8px) 24px;
    text-align: center;
  }

  .eyebrow {
    margin: clamp(4px, 1.2svh, 14px) 0 0;
    color: var(--gold-200);
    font-weight: 500;
    font-size: clamp(0.72rem, 1.6vw, 0.85rem);
    letter-spacing: 0.5em;
    /* letter-spacing adds trailing space; compensate to keep it centred */
    padding-left: 0.5em;
    text-transform: uppercase;
  }

  .headline {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, min(7vw, 7.5svh), 3.6rem);
    line-height: 1.12;
    letter-spacing: 0.02em;
    text-wrap: balance;
    filter: drop-shadow(0 2px 14px rgba(212, 161, 42, 0.18));
  }

  .headline span {
    display: block;
  }

  .sub {
    max-width: 34rem;
    margin: 0;
    color: var(--cream-dim);
    font-size: clamp(0.95rem, 2vw, 1.08rem);
    text-wrap: balance;
  }

  .domain {
    color: var(--cream);
    font-weight: 400;
    white-space: nowrap;
  }

  .divider {
    display: flex;
    align-items: center;
    gap: 14px;
    width: min(280px, 70vw);
    margin-top: clamp(4px, 1svh, 10px);
  }

  .rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold-400));
  }

  .rule:last-child {
    background: linear-gradient(270deg, transparent, var(--gold-400));
  }

  .paw {
    width: 20px;
    fill: var(--gold-400);
    animation: paw-bob 3s ease-in-out infinite 2.4s;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: var(--cream-faint);
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .pulse {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gold-200);
  }

  .pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--gold-200);
    animation: ping 2s ease-out infinite;
  }

  .cta {
    margin-top: clamp(8px, 1.6svh, 16px);
    padding: 12px 28px;
    border: 1px solid rgba(212, 161, 42, 0.6);
    border-radius: 999px;
    background: rgba(212, 161, 42, 0.06);
    color: var(--gold-200);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition:
      background-color 0.3s,
      color 0.3s,
      box-shadow 0.3s,
      translate 0.3s var(--ease-out);
  }

  .cta:hover {
    background-color: var(--gold-400);
    color: var(--ink-0);
    box-shadow: 0 10px 30px rgba(212, 161, 42, 0.3);
    translate: 0 -2px;
  }

  .footer {
    padding: 0 var(--gutter) calc(var(--gutter) + 18px);
    text-align: center;
  }

  .footer p {
    margin: 0;
    color: var(--cream-faint);
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .footer .mail {
    color: var(--gold-200);
    text-transform: none;
    letter-spacing: 0.06em;
  }

  .footer .mail:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer .sep {
    margin: 0 0.7em;
  }

  @media (max-width: 480px) {
    .footer .mail {
      display: block;
      margin-bottom: 4px;
    }

    .footer .sep {
      display: none;
    }
  }

  @keyframes paw-bob {
    0%,
    100% {
      transform: translateY(0) rotate(0);
    }
    50% {
      transform: translateY(-3px) rotate(-8deg);
    }
  }

  @keyframes ping {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    80%,
    100% {
      transform: scale(3);
      opacity: 0;
    }
  }
</style>
